864084416745229},"lastCommittedPoint":null,"startArrowhead":null,"endArrowhead":"arrow","points":[[0,0],[-363.1407293484614,-139.56341560577084],[-582.1962612002375,-437.5231060062788]]},{"type":"text","version":42,"versionNonce":1145261878,"isDeleted":false,"id":"d-R1Pmj-wPV7BFu7YdPjx","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"x":-48.5225223673624,"y":415.9232488843179,"strokeColor":"#e03131","backgroundColor":"transparent","width":158.53988647460938,"height":75,"seed":656812165,"groupIds":[],"frameId":null,"roundness":null,"boundElements":[],"updated":1747164121856,"link":null,"locked":false,"fontSize":20,"fontFamily":1,"text":"User conn shard\npushes message\nto user","textAlign":"center","verticalAlign":"middle","containerId":"jECRil1huenbvw1O90b1o","originalText":"User conn shard\npushes message\nto user","lineHeight":1.25,"baseline":68},{"type":"text","version":1994,"versionNonce":264562474,"isDeleted":false,"id":"t75kfhCEt138v9btyL9fV","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"x":881.3316229125614,"y":418.91412772186584,"strokeColor":"#1e1e1e","backgroundColor":"transparent","width":862.5794067382812,"height":350,"seed":1149354072,"groupIds":[],"frameId":null,"roundness":null,"boundElements":[],"updated":1747164121856,"link":null,"locked":false,"fontSize":20,"fontFamily":1,"text":"Connection Flow\n* User connects\n* Connect endpoint maps users to particular servers.\n* Assume 1M connections per server (network optimized instances)\n* Need 1000 servers\n* or 10k servers with 100K connectsion each so that easier to \n  rebalance shards (rebalancing would need 100K connections all reconnecting)\n* Assuming a connection needs a MB of mem - 100k = 100GB of mem.  \n* Better to go fewer connections and more nodes.   10k connections = 10GB of memory\n  and have 100K server fleet\n* Connect server redirects a connection request to the right Conn shard\n* Publish server forwards a pub request to the right conn shard\n* Both endpoints act as routers to a user shard list - can be like a \n  shard manager that rebalance when things get hot etc (eg hot groups)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Connection Flow\n* User connects\n* Connect endpoint maps users to particular servers.\n* Assume 1M connections per server (network optimized instances)\n* Need 1000 servers\n* or 10k servers with 100K connectsion each so that easier to \n  rebalance shards (rebalancing would need 100K connections all reconnecting)\n* Assuming a connection needs a MB of mem - 100k = 100GB of mem.  \n* Better to go fewer connections and more nodes.   10k connections = 10GB of memory\n  and have 100K server fleet\n* Connect server redirects a connection request to the right Conn shard\n* Publish server forwards a pub request to the right conn shard\n* Both endpoints act as routers to a user shard list - can be like a \n  shard manager that rebalance when things get hot etc (eg hot groups)","lineHeight":1.25,"baseline":343},{"type":"text","version":161,"versionNonce":1757411446,"isDeleted":false,"id":"EfCWaXgMiPtQpkCoBMU46","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"x":979.8571428571427,"y":-162.87217333524768,"strokeColor":"#1e1e1e","backgroundColor":"transparent","width":379.19970703125,"height":175,"seed":1236302667,"groupIds":[],"frameId":null,"roundness":null,"boundElements":[],"updated":1747164121856,"link":null,"locked":false,"fontSize":20,"fontFamily":1,"text":"1B DAU\nSending 1000 messages a day each\n1T messages per day\nFanout to 100 users\n\nMessage creation = 1T per day\n\"Receptions\" = 100T (across 1B users)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1B DAU\nSending 1000 messages a day each\n1T messages per day\nFanout to 100 users\n\nMessage creation = 1T per day\n\"Receptions\" = 100T (across 1B users)","lineHe